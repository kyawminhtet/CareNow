# The shared CareNow API origin. Keep credentials and service role keys server-side.
CARENOW_API_URL=http://localhost:4000

# Public Supabase project settings may be configured here once the auth adapter is implemented.
# Never put a Supabase service role key in this file or a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
