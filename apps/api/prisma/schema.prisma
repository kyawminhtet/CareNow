generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationRole {
  DOCTOR
  ADMINISTRATOR

  @@map("application_role")
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE

  @@map("account_status")
}

enum DoctorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("doctor_verification_status")
}

model AppUser {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role             ApplicationRole
  status           AccountStatus    @default(INVITED)
  displayName      String           @map("display_name")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  identityMappings IdentityMapping[]
  doctorProfile    DoctorProfile?

  @@map("app_users")
}

model IdentityMapping {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appUserId       String   @map("app_user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  appUser         AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject], map: "identity_mappings_provider_subject_unique")
  @@index([appUserId], map: "identity_mappings_app_user_id_idx")
  @@map("identity_mappings")
}

model DoctorProfile {
  appUserId           String                    @id @map("app_user_id") @db.Uuid
  specialty           String
  biography           String                    @default("")
  licenseNumber       String                    @map("license_number")
  licenseRegion       String                    @map("license_region")
  verificationStatus  DoctorVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt          DateTime?                 @map("verified_at") @db.Timestamptz(6)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  phoneNumber          String?                   @map("phone_number")
  licenseExpiry        DateTime?                 @map("license_expiry") @db.Date
  qualifications       String?
  experienceYears      Int?                      @map("experience_years")
  languages            String[]
  appUser             AppUser                   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  services             DoctorService[]
  verificationDocuments DoctorVerificationDocument[]

  @@map("doctor_profiles")
}

model DoctorService {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorUserId       String           @map("doctor_user_id") @db.Uuid
  consultationType   ConsultationType @map("consultation_type")
  specialty          String
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  doctor             DoctorProfile    @relation(fields: [doctorUserId], references: [appUserId], onDelete: Cascade)

  @@unique([doctorUserId, consultationType], map: "doctor_service_type_unique")
  @@map("doctor_services")
}

model DoctorVerificationDocument {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorUserId      String                    @map("doctor_user_id") @db.Uuid
  storageBucket     String                    @default("doctor-verification") @map("storage_bucket")
  storageObjectKey  String                    @unique @map("storage_object_key")
  documentType      String                    @map("document_type")
  reviewStatus      DoctorVerificationStatus  @default(PENDING) @map("review_status")
  uploadedAt        DateTime                  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  reviewedAt        DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId  String?                   @map("reviewed_by_user_id") @db.Uuid
  doctor            DoctorProfile             @relation(fields: [doctorUserId], references: [appUserId], onDelete: Cascade)

  @@index([doctorUserId, uploadedAt(sort: Desc)], map: "verification_documents_doctor_idx")
  @@map("doctor_verification_documents")
}

enum ConsultationType {
  ONLINE
  IN_PERSON

  @@map("consultation_type")
}
