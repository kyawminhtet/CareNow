# Shared CareNow API. Never use a service-role or database key in NEXT_PUBLIC_*.
CARENOW_API_URL=http://localhost:4000

# Supabase Auth is used only as the identity provider. Application authorization comes from the API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
