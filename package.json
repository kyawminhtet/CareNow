{
  "name": "carenow",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/mobile",
    "apps/web",
    "packages/contracts",
    "packages/design-tokens"
  ],
  "overrides": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7"
  },
  "scripts": {
    "dev": "npm run dev --workspace @carenow/web",
    "dev:api": "npm run start:dev --workspace @carenow/api",
    "dev:mobile": "npm run start --workspace @carenow/mobile",
    "build": "npm run build --workspace @carenow/web",
    "build:api": "npm run build --workspace @carenow/api",
    "lint": "npm run lint --workspace @carenow/web",
    "typecheck": "npm run typecheck --workspace @carenow/web && npm run typecheck --workspace @carenow/api && npm run typecheck --workspace @carenow/mobile"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
